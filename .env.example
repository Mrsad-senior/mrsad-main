# Copy to .env and change every value before `docker compose up`.
MIRSAD_SECRET_KEY=replace-with-a-long-random-string
MIRSAD_ADMIN_PASSWORD=replace-with-a-strong-password
POSTGRES_PASSWORD=replace-with-a-database-password
MIRSAD_ENABLE_DEMO=false

# Optional local semantic/LLM judgment (disabled unless explicitly enabled).
# Install: pip install -e '.[semantic]' (downloads multilingual encoder weights).
# Requires local Ollama and `ollama pull qwen2.5:3b` for judge. No API keys.
# Missing enabled providers fail closed on scanned untrusted tool results.
MIRSAD_SEMANTIC_ENABLED=0
MIRSAD_JUDGE_ENABLED=0
MIRSAD_JUDGE_MODEL=qwen2.5:3b
MIRSAD_INTENT_JUDGE_ENABLED=0
