# Server .env for docker compose (see docs/DEPLOY_EC2.md). Copy to .env in the repo root on the
# server and chmod 600 it. Never commit the filled-in copy.
COMPOSE_FILE=docker-compose.yml:deploy/ec2/compose.yml

# Browser origins allowed to call the API (a JSON list).
MIRSAD_CORS_ORIGINS='["https://mirsad-main.badmick73.workers.dev","https://mirsad-app.com"]'

# Secrets: fill these in on the server. Compose refuses to start while any of them is empty.
# The first two can be generated with `openssl rand -hex 32`.
MIRSAD_SECRET_KEY=
MIRSAD_ADMIN_PASSWORD=
# The Cloudflare Tunnel's token, from the Cloudflare dashboard.
TUNNEL_TOKEN=
# Supabase Postgres through the session pooler, in single quotes (format in docs/DEPLOY_EC2.md):
# 'postgresql+psycopg://postgres.<project-ref>:<url-encoded db password>@<pooler host>:5432/postgres?sslmode=require'
MIRSAD_DATABASE_URL=

# The first admin is created from MIRSAD_ADMIN_PASSWORD on the first start with an empty database.
MIRSAD_ADMIN_USERNAME=admin
MIRSAD_ENABLE_DEMO=false
MIRSAD_LOG_LEVEL=INFO
MIRSAD_APPROVAL_TIMEOUT_S=120

# Optional semantic/LLM checks stay off by default. The image has no Ollama;
# hosted judges can share the Demo LLM settings below or use the judge-specific values.
MIRSAD_SEMANTIC_ENABLED=0
MIRSAD_JUDGE_ENABLED=0
MIRSAD_JUDGE_BASE_URL=
MIRSAD_JUDGE_API_KEY=
MIRSAD_JUDGE_MODEL=qwen2.5:3b
MIRSAD_JUDGE_EXTRACTION=flag
MIRSAD_INTENT_JUDGE_ENABLED=0

# Demo agent's LLM: any OpenAI-compatible endpoint, e.g. Groq ("Demo LLM" in docs/DEPLOY_EC2.md).
MIRSAD_LLM_BASE_URL=
MIRSAD_LLM_MODEL=
MIRSAD_LLM_API_KEY=

# Optional web push for the approver PWA: set both keys or neither (the private key is a secret).
MIRSAD_VAPID_PUBLIC_KEY=
MIRSAD_VAPID_PRIVATE_KEY=
