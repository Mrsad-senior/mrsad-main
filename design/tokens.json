{
  "$description": "Mirsad design tokens extracted from Figma file Xiv89LU4esKPY8kStnT6wI (\"Mirsad — AI Agent Security Console\", Page 1) on 2026-11-04. Format follows the W3C design-tokens draft ($value/$type).",
  "$extensions": {
    "mirsad.source": {
      "figmaFile": "https://www.figma.com/design/Xiv89LU4esKPY8kStnT6wI",
      "variableCollection": "Mirsad / Foundations (one mode: Default = light)",
      "textStyles": "none defined in Figma; typography below is measured from the frames",
      "effectStyles": "none defined in Figma; no frame uses a shadow",
      "darkMode": "not in Figma. color.dark is a proposal built from the Tailwind counterparts of the Figma palette, checked for WCAG AA. Confirm with the designer."
    }
  },

  "palette": {
    "$type": "color",
    "$description": "Raw Figma variables (Mirsad / Foundations). The values are Tailwind colours; the Tailwind name is in each description.",
    "navy":    { "$value": "#1e1b4b", "$description": "Color/navy · indigo-950 · sidebar, brand panel" },
    "indigo":  { "$value": "#4f46e5", "$description": "Color/indigo · indigo-600 · primary buttons, links, active nav" },
    "teal":    { "$value": "#0d9488", "$description": "Color/teal · teal-600 · brand accent, 'Valid ✓', live dot" },
    "amber":   { "$value": "#d97706", "$description": "Color/amber · amber-600 · held / pending / countdown" },
    "rose":    { "$value": "#e11d48", "$description": "Color/rose · rose-600 · denied, critical risk, reject" },
    "green":   { "$value": "#16a34a", "$description": "Color/green · green-600 · allowed, approve" },
    "text":    { "$value": "#0f172a", "$description": "Color/text · slate-900" },
    "muted":   { "$value": "#475569", "$description": "Color/muted · slate-600 · secondary text (the most-used text colour)" },
    "border":  { "$value": "#e2e8f0", "$description": "Color/border · slate-200 · every 1px stroke" },
    "card":    { "$value": "#f8fafc", "$description": "Color/card · slate-50 · page background behind white cards" },
    "white":   { "$value": "#ffffff", "$description": "Color/white · card surface AND text on navy/indigo" },
    "amberBg": { "$value": "#fffbeb", "$description": "Color/amberBg · amber-50" },
    "roseBg":  { "$value": "#fff1f2", "$description": "Color/roseBg · rose-50" },
    "greenBg": { "$value": "#f0fdf4", "$description": "Color/greenBg · green-50" }
  },

  "color": {
    "$type": "color",
    "light": {
      "$description": "From Figma. Semantic names map the palette by how the frames use it.",
      "background":     { "$value": "{palette.card}" },
      "surface":        { "$value": "{palette.white}" },
      "border":         { "$value": "{palette.border}" },
      "text":           { "$value": "{palette.text}" },
      "textMuted":      { "$value": "{palette.muted}" },
      "primary":        { "$value": "{palette.indigo}" },
      "onPrimary":      { "$value": "{palette.white}" },
      "accent":         { "$value": "{palette.teal}" },
      "sidebar":        { "$value": "{palette.navy}" },
      "onSidebar":      { "$value": "{palette.white}" },
      "success":        { "$value": "{palette.green}" },
      "successSurface": { "$value": "{palette.greenBg}" },
      "warning":        { "$value": "{palette.amber}" },
      "warningSurface": { "$value": "{palette.amberBg}" },
      "danger":         { "$value": "{palette.rose}" },
      "dangerSurface":  { "$value": "{palette.roseBg}" },
      "onDanger":       { "$value": "{palette.white}" },
      "$extensions": {
        "mirsad.contrast": {
          "pass": "text/surface 17.9, textMuted/surface 7.6, primary/surface 6.3, onSidebar/sidebar 16.0, onDanger/danger 4.7",
          "failAA": "warning on warningSurface 3.07, success on successSurface 3.15, danger on dangerSurface 4.28, accent on surface 3.74. These pass only for bold text of 14px or larger, or text of 18px or larger; darken to the 700 shades for small badge text."
        }
      }
    },
    "dark": {
      "$description": "PROPOSED, not in Figma. Tailwind slate-900/800 surfaces with the 400 shade of each accent. All text pairs are at least 5.7:1.",
      "background":     { "$value": "#020617", "$description": "slate-950" },
      "surface":        { "$value": "#0f172a", "$description": "slate-900" },
      "border":         { "$value": "#334155", "$description": "slate-700" },
      "text":           { "$value": "#f1f5f9", "$description": "slate-100 · 16.3 on surface" },
      "textMuted":      { "$value": "#94a3b8", "$description": "slate-400 · 7.0 on surface" },
      "primary":        { "$value": "#818cf8", "$description": "indigo-400 · 6.0 on surface" },
      "onPrimary":      { "$value": "#0f172a", "$description": "6.0 on primary" },
      "accent":         { "$value": "#2dd4bf", "$description": "teal-400 · 9.6 on surface" },
      "sidebar":        { "$value": "#1e1b4b", "$description": "navy unchanged" },
      "onSidebar":      { "$value": "#ffffff" },
      "success":        { "$value": "#4ade80", "$description": "green-400 · 8.6 on successSurface" },
      "successSurface": { "$value": "#052e16", "$description": "green-950" },
      "warning":        { "$value": "#fbbf24", "$description": "amber-400 · 9.0 on warningSurface" },
      "warningSurface": { "$value": "#451a03", "$description": "amber-950" },
      "danger":         { "$value": "#fb7185", "$description": "rose-400 · 5.8 on dangerSurface" },
      "dangerSurface":  { "$value": "#4c0519", "$description": "rose-950" },
      "onDanger":       { "$value": "#0f172a", "$description": "6.6 on danger" }
    }
  },

  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "latin":  { "$value": ["Inter", "system-ui", "sans-serif"] },
      "arabic": { "$value": ["Noto Sans Arabic", "Inter", "sans-serif"], "$description": "Every Arabic/RTL frame; sizes and roles mirror the Latin ones." }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "lineHeight": { "$type": "number", "default": { "$value": 1.45, "$description": "Used on almost every text layer" } },
    "letterSpacing": { "$type": "dimension", "default": { "$value": "0px" } },
    "style": {
      "$type": "typography",
      "$description": "Roles are inferred from use; Figma has no named text styles. Counts are text runs in Latin frames.",
      "display":    { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "48px", "fontWeight": 600, "lineHeight": 1.45 }, "$description": "Sign-in hero ('Human judgment. At machine speed.') ×1" },
      "kpi":        { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "30px", "fontWeight": 600, "lineHeight": 1.45 }, "$description": "KPI values ×9" },
      "pageTitle":  { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "28px", "fontWeight": 600, "lineHeight": 1.45 }, "$description": "Page titles ×13" },
      "heading":    { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.45 }, "$description": "Section/dialog headings ×9 (22px and 17px semibold also appear ×2 each)" },
      "bodyLarge":  { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "18px", "fontWeight": 400, "lineHeight": 1.45 }, "$description": "Mostly the 18px nav glyph icons" },
      "body":       { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.45 }, "$description": "×46" },
      "bodyStrong": { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "14px", "fontWeight": 600, "lineHeight": 1.45 }, "$description": "Buttons, card titles, emphasised cells ×59" },
      "table":      { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.45 }, "$description": "Table cells, nav labels ×92" },
      "small":      { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.45 }, "$description": "Secondary lines ×101 (most used)" },
      "label":      { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "12px", "fontWeight": 600, "lineHeight": 1.45 }, "$description": "Badges, column headers ×66" },
      "caption":    { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "11px", "fontWeight": 400, "lineHeight": 1.45 }, "$description": "Meta text, uppercase eyebrows written in caps ×28" },
      "micro":      { "$value": { "fontFamily": "{typography.fontFamily.latin}", "fontSize": "10px", "fontWeight": 500, "lineHeight": 1.45 }, "$description": "×9" }
    }
  },

  "spacing": {
    "$type": "dimension",
    "$description": "Auto-layout gaps and paddings found in the frames (no spacing variables exist).",
    "0": { "$value": "0px" },
    "0.5": { "$value": "2px" },
    "1.5": { "$value": "6px", "$description": "Most-used gap (icon + label, badge contents)" },
    "2": { "$value": "8px" },
    "2.5": { "$value": "10px", "$description": "Common gap; badge horizontal padding" },
    "3": { "$value": "12px", "$description": "Gap and small-card padding" },
    "3.5": { "$value": "14px" },
    "4": { "$value": "16px" },
    "4.5": { "$value": "18px" },
    "5": { "$value": "20px", "$description": "Card padding" },
    "6": { "$value": "24px", "$description": "Card/section padding and section gap" },
    "8": { "$value": "32px", "$description": "Page padding" },
    "16": { "$value": "64px", "$description": "Sign-in brand panel padding" },
    "component": {
      "badgePadding": { "$value": "5px 10px" },
      "cardPadding": { "$value": "20px" },
      "sectionPadding": { "$value": "24px" },
      "pagePadding": { "$value": "32px" }
    }
  },

  "radius": {
    "$type": "dimension",
    "sm": { "$value": "8px", "$description": "Badges (Status components), buttons, inputs" },
    "md": { "$value": "12px", "$description": "Cards, tables, panels (most used)" },
    "lg": { "$value": "16px", "$description": "Dialogs (approve/reject confirmation)" }
  },

  "border": {
    "width": { "$type": "dimension", "default": { "$value": "1px" } },
    "color": { "$type": "color", "default": { "$value": "{color.light.border}" } }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Figma uses no shadows: elevation is a white surface with a 1px border on the slate-50 background. Dialogs sit over the page without a scrim shadow.",
    "none": { "$value": [] }
  },

  "layout": {
    "$type": "dimension",
    "frame": { "$value": "1440px", "$description": "Desktop canvas 1440×1000" },
    "sidebarWidth": { "$value": "240px", "$description": "Navy sidebar; on the right in RTL frames" },
    "contentWidth": { "$value": "1200px" },
    "signInBrandPanel": { "$value": "660px" },
    "signInFormPanel": { "$value": "780px" },
    "dialogWidth": { "$value": "540px" }
  },

  "icon": {
    "$description": "Figma has no icon library or vector icons. Icons are Unicode glyphs set as text in Inter, monochrome, taking the text colour.",
    "style": { "$value": "glyph, monochrome, inherits text colour" },
    "size": { "$type": "dimension", "nav": { "$value": "18px" }, "inline": { "$value": "20px" } },
    "glyphs": {
      "logo": { "$value": "◈", "$description": "U+25C8, before 'Mirsad  مرصاد'" },
      "navApprovals": { "$value": "▣", "$description": "U+25A3" },
      "navActivity": { "$value": "≋", "$description": "U+224B" },
      "navAudit": { "$value": "◇", "$description": "U+25C7" },
      "navSettings": { "$value": "⚙", "$description": "U+2699" },
      "timeout": { "$value": "◷", "$description": "U+25F7, 20px, auto-reject warning" },
      "statusDot": { "$value": "●", "$description": "Live / operational indicator" },
      "valid": { "$value": "✓", "$description": "Audit chain valid" },
      "alert": { "$value": "!", "$description": "In a 24×27 Status badge" }
    }
  },

  "component": {
    "statusBadge": {
      "$description": "14 'Status / …' components (● Live, 4 pending, risk scores, HELD, DENIED, ALLOWED, New beneficiary, !). Height 27, radius sm, padding 5/10, label style, colour pairs from warning/danger/success + their surfaces.",
      "height": { "$type": "dimension", "$value": "27px" },
      "radius": { "$value": "{radius.sm}" },
      "padding": { "$value": "{spacing.component.badgePadding}" },
      "text": { "$value": "{typography.style.label}" }
    }
  }
}
